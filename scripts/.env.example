# Copia a .env, rellena con las credenciales reales, y haz `source .env`
# antes de ejecutar zerto_insert-checkpoint.sh. NUNCA subas el .env real
# a git (añádelo a .gitignore) — solo este .env.example, sin valores reales.

export ORIGIN_ZVMA_HOST=zvma-origin.your-domain.local
export ORIGIN_ZVMA_PORT=443
export ORIGIN_ZVMA_USERNAME=admin@local
export ORIGIN_ZVMA_PASSWORD=CHANGE_ME
# Opcional, solo si tu ZVMA usa client_credentials además de password grant:
export ORIGIN_ZVMA_CLIENT_ID=
export ORIGIN_ZVMA_CLIENT_SECRET=

export DESTINATION_ZVMA_HOST=zvma-destination.your-domain.local
export DESTINATION_ZVMA_PORT=443
export DESTINATION_ZVMA_USERNAME=admin@local
export DESTINATION_ZVMA_PASSWORD=CHANGE_ME
export DESTINATION_ZVMA_CLIENT_ID=
export DESTINATION_ZVMA_CLIENT_SECRET=
